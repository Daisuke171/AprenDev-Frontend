    }

    .streak {
      grid-row: 14 / 20;
      grid-column: 1 / -1;
      border: 2px solid rgb(55, 0, 76);
      color: rgb(55, 0, 76);
      margin: 15px;
      border-radius: 20px;
      z-index: 2;
      padding: 15px;
