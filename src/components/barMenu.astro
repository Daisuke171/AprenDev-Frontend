---
const { width = "40px", height = "40px" } = Astro.props;
const token = Astro.cookies.get("session_id")?.value;
let avatarUrl = "/image-perfil.png"; // fallback

if (token) {
  try {
    const API_BASE = import.meta.env.PUBLIC_API_BASE ?? "http://localhost:3010";
    const res = await fetch(`${API_BASE}/auth/session`, {
      headers: { cookie: `session_id=${token}` },
    });
    if (res.ok) {
      const data = await res.json();
      if (data.avatar) {
        avatarUrl = data.avatar;
      }
    }
  } catch (err) {
    console.warn("Error obteniendo avatar:", err);
  }
}
---

<nav class="barMenu">
  <a class="iconContainer" href="/">
    <img src="/home.png" alt="Home Icon" />
    <p>Home</p>
  </a>

  <a class="iconContainer" href="/community">
    <img src="/friends.png" alt="Home Icon" />
    <p>Social</p>
  </a>

  <a class="iconContainer" href="/trophies">
    <img src="/trophy.png" alt="Home Icon" />
    <p>Trofeos</p>
  </a>

  <a class="iconContainer">
    <img src="/createCode.png" alt="Home Icon" />
    <p>Crear</p>
  </a>

  <a class="iconContainer" href="/profile">
    <img src={avatarUrl} alt="Foto de perfil" class="profile-icon" />
    <p>Perfil</p>
  </a>
</nav>

<style>
  .barMenu {
    display: flex;
    flex-direction: row;
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    justify-content: space-around;
    align-items: center;
    padding: 10px;
    background: #f1edfa;
    z-index: 1000;
  }

  .barMenu img {
    width: 40px;
    height: 40px;
  }
  .iconContainer {
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
  }
  .iconContainer p {
    font-size: 1rem;
    color: #24014a;
  }

  .profile-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }
</style>
