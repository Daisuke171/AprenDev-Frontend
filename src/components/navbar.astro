---
import Burguer from "../assets/burguer.astro";
import Bell from "../assets/bell.astro";
import Logout from "../assets/logout.astro";

const { title, transparent } = Astro.props; //prop para trasnparente
let navTitle = title ?? "home";

//saludo en home
if (!title) {
  const token = Astro.cookies.get("session_id")?.value;
  if (token) {
    try {
      const apiBase =
        import.meta.env.PUBLIC_API_BASE ?? "http://localhost:3010";

      const res = await fetch(`${apiBase}/auth/session`, {
        headers: { cookie: `session_id=${token}` },
      });
      if (res.ok) {
        const data = await res.json();
        navTitle = `Hola ${data.username}`;
      } else {
        console.warn("Session fetch returned status:", res.status);
      }
    } catch (err) {
      console.warn(
        "Error fetching session (server-side):",
        err?.message ?? err,
      );
      // Mantener navTitle por defecto (no interrumpir SSR)
    }
  }
}
---

<!-- si es true se pone transparente -->
<nav class={`navbar ${transparent ? "navbar--transparent" : ""}`}>
  <button id="btnBurguer" aria-label="Open Menu">
    <Burguer w="35px" h="35px" />
  </button>

  <a id="navTitle" data-default={navTitle}>{navTitle}</a>

  <section id="rightSideNav">
    <button class="icon-btn"><Bell w="22px" /></button>
    <button id="btnLogout" class="icon-btn"><Logout w="22px" h="22px" /></button
    >
  </section>
</nav>

<div id="menuOverlay"></div>

<aside id="sideMenu">
  <div class="menu-content">
    <div class="menu-section">
      <p class="section-label">Navegación Principal</p>
      <a href="/">Inicio</a>
      <a href="/cursos">Cursos</a>
    </div>

    <div class="menu-section">
      <p class="section-label">Cuenta</p>
      <a href="/profile">Configuración de Perfil</a>
    </div>

    <div class="menu-section">
      <p class="section-label">Soporte</p>
      <a href="/help">Help Center</a>
    </div>
  </div>

  <div class="menu-footer">
    <p>Version 0.6 alpha</p>
  </div>
</aside>

<style>
  /* Navigation Bar */
  nav {
    display: flex;
    position: fixed;
    top: 0;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: #f1edfa;
    backdrop-filter: blur(10px);
    z-index: 100;
  }

  #btnBurguer,
  .icon-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 5px;
    display: flex;
    align-items: center;
    transition: transform 0.2s ease;
  }

  #btnBurguer:hover {
    transform: scale(1.1);
  }

  #navTitle {
    font-size: 1.2rem;
    font-weight: 700;
    color: #240e59;
    letter-spacing: -0.5px;
  }

  #rightSideNav {
    display: flex;
    gap: 10px;
  }

  /* Overlay - Darker and blurrier */
  #menuOverlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 7, 34, 0.3);
    backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1001;
  }

  /* Side menu - Glassmorphism Style */
  #sideMenu {
    position: fixed;
    top: 0;
    left: -320px;
    width: 300px;
    height: 100vh;
    /* The Glass Effect */
    background: rgba(36, 14, 89, 0.7);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-right: 1px solid rgba(255, 255, 255, 0.1);

    padding: 100px 30px 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1001;
  }

  #sideMenu.open {
    transform: translateX(320px);
  }

  #menuOverlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Menu Content Styling */
  .menu-section {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .section-label {
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin-bottom: 5px;
  }

  #sideMenu a {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    font-size: 1.1rem;
    padding: 8px 12px;
    border-radius: 8px;
    transition: all 0.2s ease;
    background: rgba(255, 255, 255, 0);
  }

  #sideMenu a:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    padding-left: 18px;
  }

  .menu-footer {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .navbar--transparent {
    background-color: transparent;
    backdrop-filter: none;
  }
</style>

<script>
  import { io } from "socket.io-client";

  const initNav = () => {
    // Mantén socket para otras funciones si quieres
    const SOCKET_URL =
      import.meta.env.VITE_WS_URL ??
      import.meta.env.PUBLIC_API_BASE ??
      "http://localhost:3010";

    const socket = io(SOCKET_URL, {
      withCredentials: true,
      transports: ["websocket"], // evita polling XHR
      reconnectionAttempts: 3,
    });

    
    const btn = document.getElementById("btnBurguer");
    const menu = document.getElementById("sideMenu");
    const overlay = document.getElementById("menuOverlay");
    const btnLogout = document.getElementById("btnLogout");
    const navTitleEl = document.getElementById("navTitle");

    const toggleMenu = (show) => {
      menu?.classList.toggle("open", show);
      overlay?.classList.toggle("open", show);
    };

    btn?.addEventListener("click", () => toggleMenu(true));
    overlay?.addEventListener("click", () => toggleMenu(false));

    // Actualiza el saludo desde el servidor (envía cookies httpOnly automáticamente)
    async function clientFetchSession() {
      try {
        const res = await fetch("http://localhost:3010/auth/session", {
          credentials: "include",
        });
        if (!res.ok) return;
        const data = await res.json();
        if (navTitleEl) navTitleEl.textContent = `Hola ${data.username}`;
      } catch (err) {
        console.error("Error fetching session:", err);
      }
    }

    // Logout por HTTP (recomendado): el servidor borrará la cookie httpOnly
    btnLogout?.addEventListener("click", async () => {
      try {
        await fetch("http://localhost:3010/auth/logout", {
          method: "POST",
          credentials: "include",
        });
      } catch (err) {
        console.error("Logout error:", err);
      } finally {
        // Redirigir o actualizar UI
        window.location.href = "/login";
      }
    });

    socket.on("error", (err) => {
      console.error("Error desde el servidor:", err?.message ?? err);
    });

    // Llamada inicial para que el nav muestre el username si hay sesión
    clientFetchSession();
  };

  initNav();
  document.addEventListener("astro:after-swap", initNav);
</script>
